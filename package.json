{
  "name": "facefall-survivor",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:next": "vite --config vite.config.ts",
    "build:next": "vite build --config vite.config.ts",
    "build:deploy": "npm run build:next && node scripts/promote-engine-next.mjs",
    "preview:next": "vite preview --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "rm -rf .test-dist && tsc -p tsconfig.tests.json && printf '{\"type\":\"commonjs\"}\n' > .test-dist/package.json && node --test .test-dist/tests/unit/*.test.js",
    "test:smoke": "playwright test tests/smoke"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.0.0",
    "@types/three": "0.160.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
